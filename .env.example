# Defaults to SQLite. Paths are relative to the project directory.
DBPATH=storage/db/bot.db
DB_MYSQL=0
QUEUE_TIMEZONE=Europe/Moscow

# Standalone process: polling or webhook. WSGI always receives HTTP updates.
BOT_MODE=polling
# Webhook server listens locally; expose it through an HTTPS reverse proxy.
BOT_HOST=127.0.0.1
BOT_PORT=5000
# Required for WSGI maintenance via /api/ping; generate a separate random secret.
PING_TOKEN=

# Optional MySQL instead of SQLite:
# DB_MYSQL=1
# DBPATH=queuebot:password@127.0.0.1/queuebot
